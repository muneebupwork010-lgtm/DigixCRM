# ==========================================================
# DigiXCrm - Environment Configuration Template
# ==========================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/digixcrm_db?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"
TRUST_HOST=true

# Webhook Secrets for Third-Party Integrations
WP_WEBHOOK_SECRET="your_wp_webhook_secret"
META_WEBHOOK_VERIFY_TOKEN="your_meta_verify_token"
LINKEDIN_WEBHOOK_SECRET="your_linkedin_secret"
UPWORK_WEBHOOK_SECRET="your_upwork_secret"

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_ID=""
WHATSAPP_ACCESS_TOKEN=""

# SMTP / Email Provider (Magic Links & Notifications)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="your-email@example.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="Your Brand <noreply@yourdomain.com>"

# Authentication Providers (Google OAuth)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Initial System Access
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="ChooseAStrongPassword123!"
RECOVERY_EMAIL="recovery@yourdomain.com"

# ==========================================================
# SECURITY & BOT PROTECTION (Cloudflare Turnstile)
# ==========================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key"

# ==========================================================
# PII FIELD-LEVEL ENCRYPTION (Secure Vault)
# ==========================================================
# REQUIRED for SSN, DOB, and other PII encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Losing this key means ALL encrypted PII data becomes unrecoverable.
FIELD_ENCRYPTION_KEY=""

# ==========================================================
# MASTER SAAS PAYMENT GATEWAYS (Client Billing)
# ==========================================================

# 1. Stripe (Card Payments)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe SaaS Pricing Tiers (Product Price IDs)
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_ENT_MONTHLY="price_..."

# 2. PayPal
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"

# 3. Authorize.Net
AUTHORIZE_NET_API_LOGIN_ID=""
AUTHORIZE_NET_TRANSACTION_KEY=""

# 4. Square (Alternative Billing)
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_PLAN_STARTER_MONTHLY=""
SQUARE_PLAN_PRO_MONTHLY=""
SQUARE_PLAN_ENT_MONTHLY=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# Must exactly match the notification URL configured in the Square Developer portal.
SQUARE_WEBHOOK_NOTIFICATION_URL="https://your-domain.com/api/webhooks/square"

# ==========================================================
# SCHEDULED JOBS
# ==========================================================
# Shared secret for /api/cron/* routes. Callers must send: Authorization: Bearer <value>
CRON_SECRET=""

# ==========================================================
# AI ASSISTANT
# ==========================================================
GEMINI_API_KEY=""

# ==========================================================
# STORAGE & FILE UPLOADS (Cloudflare R2 / AWS S3)
# ==========================================================
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_DOMAIN="your-bucket-subdomain.r2.dev"

# ==========================================================
# TELEPHONY (RingCentral Embeddable softphone)
# ==========================================================
# Client ID of your RingCentral app (App type: "Browser based" / public).
# Exposed to the browser, so it must be the public SPA client id (this is expected by Embeddable).
NEXT_PUBLIC_RINGCENTRAL_CLIENT_ID=""
# Production: https://platform.ringcentral.com  |  Sandbox: https://platform.devtest.ringcentral.com
NEXT_PUBLIC_RINGCENTRAL_SERVER="https://platform.ringcentral.com"
